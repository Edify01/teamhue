# ---------------------------------------------------------------------------
# TeamHue configuration
#
# 1. Create a free project at https://supabase.com
# 2. Dashboard → Project Settings → API
# 3. Copy this file to `.env` and paste the two values below
# 4. Run `npm run build`
#
# The anon key is PUBLIC and safe to ship inside the extension — it is gated by
# the Row Level Security policies in supabase/schema.sql.
# NEVER put the `service_role` key here. It bypasses all security.
# ---------------------------------------------------------------------------

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
